<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:VistaCampo.Modelos"
             x:Class="VistaCampo.Vistas.PerfilPagina"
             Title="Perfil">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding Nombre}" FontSize="20" FontAttributes="Bold" />
                    <Label Text="{Binding Usuario}" Style="{StaticResource Tenue}" />
                    <Label Text="{Binding Rol}" Style="{StaticResource Tenue}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Instalación" Style="{StaticResource Etiqueta}" />
                    <Label Text="{Binding Identidad}" />
                    <Label Text="{Binding Modo}" Style="{StaticResource Tenue}" />
                    <Label Text="{Binding Servidor}" Style="{StaticResource Tenue}" />
                    <Label Text="{Binding UltimaSync, StringFormat='Última descarga: {0}'}"
                           Style="{StaticResource Tenue}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Descargar catálogos" Style="{StaticResource BotonSecundario}"
                    Command="{Binding DescargarCatalogosCommand}" />

            <Label Text="Tu cola de envío" Style="{StaticResource Titulo}" FontSize="19" />
            <Label Style="{StaticResource Tenue}"
                   IsVisible="{Binding Cola.Count, Converter={StaticResource ListaVacia}}"
                   Text="No tienes nada pendiente por subir." />

            <CollectionView ItemsSource="{Binding Cola}" HeightRequest="300">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:EnvioPendiente">
                        <Border Style="{StaticResource Tarjeta}" Margin="0,0,0,8">
                            <VerticalStackLayout Spacing="2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding Etiqueta}" FontAttributes="Bold" />
                                    <Label Grid.Column="1" FontAttributes="Bold" FontSize="13"
                                           Text="{Binding Estado, Converter={StaticResource EstadoTexto}}"
                                           TextColor="{Binding Estado, Converter={StaticResource EstadoColor}}" />
                                </Grid>
                                <Label Style="{StaticResource Tenue}"
                                       Text="{Binding MinutosDesdeCaptura, StringFormat='Capturado hace {0} min'}" />
                                <!-- El aviso ANTES del rechazo: pasada la hora el servidor
                                     ya no acepta la visita, y enterarse entonces no sirve. -->
                                <Label FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Aviso}"
                                       IsVisible="{Binding PorVencer}"
                                       Text="Envíalo pronto: el sistema solo acepta visitas de la última hora." />
                                <Label FontSize="12" TextColor="{StaticResource Error}"
                                       IsVisible="{Binding Motivo, Converter={StaticResource HayTexto}}"
                                       Text="{Binding Motivo}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Reintentar los que no entraron" Style="{StaticResource BotonSecundario}"
                    Command="{Binding ReintentarCommand}" />

            <Label Text="{Binding Aviso}" IsVisible="{Binding HayAviso}" TextColor="{StaticResource Aviso}" />
            <Label Text="{Binding Error}" IsVisible="{Binding HayError}" TextColor="{StaticResource Error}" />

            <Button Text="Cerrar sesión" Style="{StaticResource BotonSecundario}"
                    TextColor="{StaticResource Error}" Command="{Binding SalirCommand}" Margin="0,10,0,0" />
            <Label Style="{StaticResource Tenue}" HorizontalOptions="Center"
                   Text="Lo que tengas sin enviar se conserva al cerrar sesión." />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
