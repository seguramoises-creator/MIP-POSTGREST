<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:VistaCampo.Modelos"
             xmlns:vm="clr-namespace:VistaCampo.VistaModelos"
             xmlns:v="clr-namespace:VistaCampo.Vistas"
             x:Class="VistaCampo.Vistas.HoyPagina"
             Title="Hoy">

    <RefreshView IsRefreshing="{Binding Refrescando, Mode=TwoWay}" Command="{Binding RefrescarCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="10" Spacing="8">

                <!-- El ciclo que se trabaja, en su propia tarjeta. -->
                <v:TarjetaCiclo BindingContext="{Binding Ciclo}" />

                <!-- Estado de la cola: lo primero, porque es lo que responde «¿subió mi trabajo?» -->
                <Border Style="{StaticResource Tarjeta}">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="📤  Estado de envío" Style="{StaticResource Tenue}" />
                            <Label Text="{Binding EstadoCola}" FontSize="15" FontAttributes="Bold" />
                            <Label Text="{Binding DetalleCola}" Style="{StaticResource Tenue}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="🔄  Sincronizar" Style="{StaticResource BotonSecundario}"
                                WidthRequest="130" Command="{Binding SincronizarCommand}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Tarjeta}" BackgroundColor="#FFF4E5"
                        IsVisible="{Binding HayAviso}">
                    <Label Text="{Binding Aviso}" TextColor="{StaticResource Aviso}" />
                </Border>
                <Border Style="{StaticResource Tarjeta}" BackgroundColor="#FDECEA"
                        IsVisible="{Binding HayError}">
                    <Label Text="{Binding Error}" TextColor="{StaticResource Error}" />
                </Border>

                <Border Style="{StaticResource Tarjeta}" IsVisible="{Binding PuedeCapturar, Converter={StaticResource Negar}}"
                        BackgroundColor="#FFF4E5">
                    <Label Text="{Binding AvisoSoloConsulta}" TextColor="{StaticResource Aviso}" />
                </Border>

                <Border Style="{StaticResource Tarjeta}" IsVisible="{Binding SinCatalogos}" BackgroundColor="#FFF4E5">
                    <Label TextColor="{StaticResource Aviso}"
                           Text="Todavía no se han descargado tus médicos. Toca Sincronizar cuando tengas señal." />
                </Border>

                <!-- Cifras del día -->
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="5">
                    <Border Style="{StaticResource Tarjeta}">
                        <VerticalStackLayout>
                            <Label Text="🩺 Vistas" Style="{StaticResource Tenue}" FontSize="9" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding TextoVistas}" FontSize="19" FontAttributes="Bold" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Tarjeta}">
                        <VerticalStackLayout>
                            <Label Text="🔁 Revisitas" Style="{StaticResource Tenue}" FontSize="9" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding TextoRevisitas}" FontSize="19" FontAttributes="Bold" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Tarjeta}">
                        <VerticalStackLayout>
                            <Label Text="🏥 Farmacias" Style="{StaticResource Tenue}" FontSize="9" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding TextoFarmacias}" FontSize="19" FontAttributes="Bold" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource Tarjeta}">
                        <VerticalStackLayout>
                            <Label Text="👥 Con gerente" Style="{StaticResource Tenue}" FontSize="9" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding TextoAcompanadas}" FontSize="19" FontAttributes="Bold" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- AGENDA DE HOY: lo programado para hoy. La ✓ es «visitado HOY». Va en una
                     lista que crece con su contenido: con alto fijo cortaba la lista y dejaba
                     un hueco vacío debajo. -->
                <Label Text="{Binding TituloAgenda}" Style="{StaticResource Titulo}" FontSize="15" Margin="0,6,0,0" />
                <Label Style="{StaticResource Tenue}"
                       Text="✓ ☁️ ya está en el servidor  ·  📱 guardado en el teléfono, por enviar" />
                <Label Style="{StaticResource Tenue}" IsVisible="{Binding SinAgendaHoy}"
                       Text="No tienes médicos programados para hoy en tu planeación." />
                <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding AgendaHoy}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:FilaHoy">
                            <Border Style="{StaticResource Tarjeta}" Padding="7">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
                                    <Label Text="{Binding Icono}" VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1">
                                        <Label Text="{Binding Nombre}" FontAttributes="Bold" FontSize="12" />
                                        <Label Text="{Binding Detalle}" Style="{StaticResource Tenue}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding Marca}" FontSize="20" VerticalOptions="Center"
                                           TextColor="{StaticResource Exito}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding NoVisitado}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource Error}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- FUERA DE AGENDA: separado y en otro color, para que no se confunda con lo
                     programado. -->
                <Border BackgroundColor="#FFF4E5" StrokeThickness="0" Padding="9,6" Margin="0,8,0,0"
                        StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout>
                        <Label Text="{Binding TituloFuera}" FontAttributes="Bold" FontSize="15"
                               TextColor="{StaticResource Aviso}" />
                        <Label Style="{StaticResource Tenue}"
                               Text="Registrado hoy sin estar programado para hoy: médicos de otro día o fuera de tu plan, y farmacias." />
                    </VerticalStackLayout>
                </Border>
                <Label Style="{StaticResource Tenue}" IsVisible="{Binding SinFuera}" Text="{Binding TextoFueraVacio}" />
                <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding FueraDeAgenda}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:FilaHoy">
                            <Border Style="{StaticResource Tarjeta}" Padding="7" BackgroundColor="#FFFBF3"
                                    Stroke="{StaticResource Aviso}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
                                    <Label Text="{Binding Icono}" VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1">
                                        <Label Text="{Binding Nombre}" FontAttributes="Bold" FontSize="12" />
                                        <Label Text="{Binding Detalle}" Style="{StaticResource Tenue}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2" Text="{Binding Marca}" FontSize="20" VerticalOptions="Center"
                                           TextColor="{StaticResource Exito}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding NoVisitado}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource Error}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
