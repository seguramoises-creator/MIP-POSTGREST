<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:VistaCampo.Modelos"
             x:Class="VistaCampo.Vistas.PanelPagina"
             Title="Panel">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="10" RowSpacing="7">

        <Entry Text="{Binding Busqueda}" Placeholder="Buscar por nombre"
               Keyboard="Plain" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" />

        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button Text="🩺  Médicos" HeightRequest="44" FontSize="12" Style="{StaticResource BotonSecundario}"
                    BackgroundColor="{Binding VerFarmacias, Converter={StaticResource ColorSeleccion}, ConverterParameter=inverso}"
                    Clicked="VerMedicos" />
            <Button Grid.Column="1" Text="🏥  Farmacias" HeightRequest="44" FontSize="12" Style="{StaticResource BotonSecundario}"
                    BackgroundColor="{Binding VerFarmacias, Converter={StaticResource ColorSeleccion}}"
                    Clicked="VerFarmacias" />
        </Grid>

        <!-- El alta va aquí, junto a la lista donde se ve qué falta: es el sitio donde
             el visitador se da cuenta de que el médico que acaba de visitar no está. -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8">
            <Button Text="🩺➕  Médico" HeightRequest="44" FontSize="12" Style="{StaticResource BotonSecundario}"
                    Clicked="NuevoMedico" />
            <Button Grid.Column="1" Text="🏥➕  Farmacia" HeightRequest="44" FontSize="12" Style="{StaticResource BotonSecundario}"
                    Clicked="NuevaFarmacia" />
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource Tarjeta}" BackgroundColor="#FFF4E5"
                IsVisible="{Binding HayPendientes}">
            <Label Text="{Binding TextoPendientes}" TextColor="{StaticResource Aviso}" />
        </Border>

        <CollectionView Grid.Row="4" ItemsSource="{Binding Medicos}"
                        IsVisible="{Binding VerFarmacias, Converter={StaticResource Negar}}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="m:MedicoPanel">
                    <Border Style="{StaticResource Tarjeta}" Margin="0,0,0,3" Padding="7">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                            <Border WidthRequest="22" HeightRequest="22" StrokeThickness="0"
                                    BackgroundColor="#D6E4FF" StrokeShape="RoundRectangle 11"
                                    VerticalOptions="Center">
                                <Label Text="{Binding TextoCategoria}" FontSize="10" FontAttributes="Bold"
                                       TextColor="#1E52C7" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="{Binding Nombre}" FontAttributes="Bold" FontSize="12" />
                                <Label Text="{Binding Subtitulo}" Style="{StaticResource Tenue}" FontSize="10"
                                       IsVisible="{Binding HaySubtitulo}" />
                                <Label FontSize="10" FontAttributes="Bold" TextColor="{StaticResource Aviso}"
                                       Text="Pendiente de aprobación del Gerente de Distrito"
                                       IsVisible="{Binding SePuedeVisitar, Converter={StaticResource Negar}}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <CollectionView Grid.Row="4" ItemsSource="{Binding Farmacias}"
                        IsVisible="{Binding VerFarmacias}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="m:FarmaciaPanel">
                    <Border Style="{StaticResource Tarjeta}" Margin="0,0,0,3" Padding="7">
                        <VerticalStackLayout>
                            <Label Text="{Binding Nombre}" FontAttributes="Bold" FontSize="12" />
                            <Label Text="{Binding Detalle}" Style="{StaticResource Tenue}" FontSize="10" />
                            <Label FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Aviso}"
                                   Text="Pendiente de aprobación"
                                   IsVisible="{Binding SePuedeVisitar, Converter={StaticResource Negar}}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
