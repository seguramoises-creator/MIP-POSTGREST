<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- SOLO ANDROID. El proyecto queda multiplataforma por dentro (MAUI lo es), pero
		     no se compila iOS ni Windows: cada objetivo extra alarga la compilación y
		     esconde errores que nadie va a ver, porque la app se usa en el teléfono del
		     visitador y en ningún otro sitio. Añadir un objetivo el día que haga falta
		     es una línea. -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>VistaCampo</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>VISTA Campo</ApplicationTitle>
		<ApplicationId>com.vistamip.campo</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Android 8.0 como suelo: por debajo quedan teléfonos que ya no reciben
		     actualizaciones de seguridad y que en la calle son minoría. -->
		<SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- El icono es la LUPA de VISTA sobre el azul profundo de la marca. Va como
		     PNG con transparencia y no como vectorial porque el logotipo no tiene uno:
		     el `.svg` que existe lleva un JPEG incrustado (ver `identidades.ts`).
		     `Color` pinta el fondo del icono adaptativo, así que el azul se ve alrededor
		     del dibujo sea cual sea la forma que recorte el lanzador. -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.png" Color="#011D42" />
		<MauiSplashScreen Include="Resources\AppIcon\appiconfg.png" Color="#011D42" BaseSize="180,180" />
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<!-- MVVM por generador de código: evita escribir a mano el INotifyPropertyChanged
		     de cada propiedad, que es donde se cuelan los errores de refresco. -->
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<!-- La base local. No es una caché opcional: mientras no hay red ES la fuente de
		     verdad de lo que el visitador capturó. -->
		<!-- `sqlite-net-base` y no `sqlite-net-pcl`: son la MISMA biblioteca, pero la
		     segunda arrastra `bundle_green` como dependencia fija y no hay forma de
		     sacárselo. La `base` deja elegir el motor, que es justo lo que hace falta
		     aquí. A cambio hay que arrancar el proveedor a mano (`Batteries_V2.Init()`
		     en `MauiProgram`); sin esa llamada, la app falla al abrir la base. -->
		<PackageReference Include="sqlite-net-base" Version="1.9.172" />
		<!-- `bundle_green` (SQLite propio, empaquetado con la app) en su versión 2.1.13.
		     Las dos decisiones tienen historia y conviene no repetirla:

		     1. NO usar `bundle_sqlite3`. Ese usa el SQLite DEL SISTEMA, que sobre el
		        papel es mejor —lo parchea el fabricante del teléfono— y por eso lo elegí
		        primero para esquivar la vulnerabilidad del binario propio. En Android NO
		        FUNCIONA: `libsqlite3.so` no está en la lista de bibliotecas públicas del
		        NDK, así que el enlazador la bloquea y la app revienta AL ARRANCAR con
		        `DllNotFoundException: sqlite3`. Compila, empaqueta, instala… y muere en
		        `Batteries_V2.Init`. Solo se vio al ejecutarla en un teléfono real.

		     2. El BINARIO nativo se fija en 2.1.13, que es la versión más nueva
		        publicada: la 2.1.10 que arrastra la biblioteca por defecto tiene una
		        vulnerabilidad de severidad alta declarada (GHSA-2m69-gcr7-jv3q), y es
		        justo ese paquete —`lib.e_sqlite3`— el que la lleva. El `bundle_green`
		        se queda en 2.1.11 porque no hay publicada ninguna posterior; lo que
		        importa subir es el nativo, y fijarlo aquí evita que la resolución de
		        dependencias vuelva a bajarlo por la puerta de atrás. -->
		<!-- SOLO el nativo `.android`. Añadir además `SQLitePCLRaw.lib.e_sqlite3` —el
		     paquete genérico— parece más completo y rompe la app: ese trae los binarios
		     de Linux de escritorio, compilados contra glibc, y el empaquetado se los
		     lleva al APK. El teléfono los rechaza al arrancar con
		     `dlopen failed: library "libc.so.6" not found`, porque Android no usa glibc
		     sino Bionic. El síntoma que se ve arriba es `DllNotFoundException: e_sqlite3`
		     con el .so DENTRO del APK: está, pero no es para este sistema. -->
		<PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.11" />
		<PackageReference Include="SQLitePCLRaw.core" Version="2.1.13" />
		<PackageReference Include="SQLitePCLRaw.provider.e_sqlite3" Version="2.1.13" />
		<PackageReference Include="SQLitePCLRaw.lib.e_sqlite3.android" Version="2.1.13" />
	</ItemGroup>

</Project>
