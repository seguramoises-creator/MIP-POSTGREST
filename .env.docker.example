# Variables para docker compose (copiar a ".env" en la raíz del repo).
# Estas las lee compose para sustitución ${...}; la config de la APP va en backend/.env.

# ¿Correr migraciones Alembic al arrancar el backend? (1 = sí)
RUN_MIGRATIONS=1

# Solo si usas el perfil "with-db" (SQL Server en contenedor): clave fuerte del SA.
# Requisitos SQL Server: 8+ chars, mayúscula, minúscula, número y símbolo.
MSSQL_SA_PASSWORD=Cambia.Esta.Clave_2026
