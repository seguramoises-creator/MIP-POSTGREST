# Variables para docker compose (copiar a ".env" en la raíz del repo).
# Estas las lee compose para sustitución ${...}; la config de la APP va en backend/.env.

# ¿Correr migraciones Alembic al arrancar el backend? (1 = sí)
RUN_MIGRATIONS=1

# Puerto del HOST donde se publica el frontend (→ 80 del contenedor).
# Default 8090 para no chocar con otros stacks del servidor (p.ej. DW/Odoo en
# srv1772225). El nginx del host (TLS) hace proxy 443 → 127.0.0.1:${FRONTEND_PORT}.
FRONTEND_PORT=8090

# Solo si usas el perfil "with-db" (PostgreSQL en contenedor).
# Deben coincidir con DB_NAME/DB_USER/DB_PASSWORD de backend/.env (DB_SERVER=db).
DB_NAME=scgcpr
DB_USER=segura
POSTGRES_PASSWORD=Cambia.Esta.Clave_2026
