# ─────────────────────────────────────────────────────────────
# MSM / SCGCPR — Plantilla de variables de entorno (desarrollo)
# Copiar a backend/.env y rellenar con valores reales.
# NUNCA commitear el .env real (está en .gitignore).
# ─────────────────────────────────────────────────────────────

APP_NAME=SCGCPR
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1

# ── Servidor (usado por los scripts de arranque) ──────────────
HOST=127.0.0.1
PORT=8000
WORKERS=1

# ── SQL Server (usar IP, no nombre de instancia) ──────────────
DB_SERVER=127.0.0.1
DB_PORT=1433
DB_NAME=SCGCPR
DB_USER=tu_usuario_db
DB_PASSWORD=__CAMBIAR__

# ── JWT — generar un secreto único por entorno ────────────────
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=__GENERAR_SECRETO_UNICO__
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS (JSON array o CSV) ───────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Hosts permitidos (solo activo si APP_ENV=production) ───────
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# ── Proxy inverso (producción) ────────────────────────────────
FORWARDED_ALLOW_IPS=127.0.0.1
PUBLIC_BASE_URL=http://localhost:8000

# ── Redis (blacklist de tokens en producción) ─────────────────
REDIS_URL=redis://localhost:6379/0

# ── Notificaciones por correo (vacío = deshabilitado) ─────────
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=Sistema MIP — SCGCPR
MAIL_TLS=true
MAIL_SSL=false

# ── ETL / Reportes ────────────────────────────────────────────
ETL_UPLOAD_DIR=uploads
ETL_PROCESSED_DIR=processed
ETL_ERROR_DIR=errors
ETL_MAX_FILE_SIZE_MB=50
REPORTS_DIR=reports

LOG_LEVEL=INFO
LOG_FILE=logs/scgcpr.log
