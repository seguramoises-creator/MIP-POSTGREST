# ═══════════════════════════════════════════════════════════════════
# MSM / SCGCPR — Plantilla de variables de entorno para PRODUCCIÓN
# ═══════════════════════════════════════════════════════════════════
# Copie este archivo a backend\.env en el servidor de producción y
# reemplace TODOS los valores marcados con <...>. NO use los valores
# de backend\.env de desarrollo: las credenciales y el secreto JWT
# deben ser distintos y exclusivos del entorno productivo.
#
# Tras editar, valide que el backend arranca sin errores:
#   venv\Scripts\python -c "from app.core.config import settings; print(settings.APP_ENV, settings.is_production)"
# ═══════════════════════════════════════════════════════════════════

APP_NAME=SCGCPR
APP_VERSION=1.0.0
APP_ENV=production
DEBUG=false
API_PREFIX=/api/v1

# ── Servidor (leído por los scripts de arranque, no por uvicorn directamente)
HOST=127.0.0.1
PORT=8000
WORKERS=2

# ── SQL Server - Credenciales de conexión de PRODUCCIÓN
# CRÍTICO: use un usuario de BD dedicado a producción, distinto del de desarrollo.
DB_SERVER=<ip_o_host_sql_server_produccion>
DB_PORT=1433
DB_NAME=SCGCPR
DB_USER=<usuario_bd_produccion>
DB_PASSWORD=<password_bd_produccion>

# ── JWT
# CRÍTICO: genere un secreto único y fuerte (mínimo 32 caracteres aleatorios).
# El validador en app/core/config.py RECHAZA el arranque en producción si
# este valor es el de desarrollo, está vacío, o es "secret".
# Genere uno con: deploy\windows\generar_jwt_secret.ps1  (Windows)
#              o: openssl rand -base64 48                 (Linux/macOS)
JWT_SECRET_KEY=<generar_secreto_fuerte_unico_de_produccion>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS — dominios autorizados a llamar a la API desde el navegador
CORS_ORIGINS=["https://vista-mip.com","https://www.vista-mip.com"]

# ── Hosts permitidos (TrustedHostMiddleware) — debe coincidir con el
# encabezado Host que IIS/ARR o nginx reenvían al backend.
# CRÍTICO: si "vista-mip.com" no está aquí, el backend responde 400 a TODO
# el tráfico en producción.
ALLOWED_HOSTS=["vista-mip.com","www.vista-mip.com","localhost","127.0.0.1"]

# ── Proxy inverso
FORWARDED_ALLOW_IPS=127.0.0.1
PUBLIC_BASE_URL=https://vista-mip.com

REDIS_URL=redis://localhost:6379/0

# ── Notificaciones por correo (opcional, vacío = deshabilitado)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@vista-mip.com
MAIL_FROM_NAME=Sistema MIP — SCGCPR
MAIL_TLS=true
MAIL_SSL=false

# ── ETL
ETL_UPLOAD_DIR=uploads
ETL_PROCESSED_DIR=processed
ETL_ERROR_DIR=errors
ETL_MAX_FILE_SIZE_MB=50
REPORTS_DIR=reports

# ── Logging
LOG_LEVEL=INFO
LOG_FILE=logs/scgcpr.log
