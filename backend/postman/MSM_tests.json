{
  "info": {
    "name": "MSM API — Suite de Pruebas",
    "_postman_id": "msm-test-suite-v1",
    "description": "Suite de pruebas completa para la API MSM. Cubre autenticación JWT, endpoints protegidos y casos de error (401, 403, 422).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "{{baseUrl}}" }
  ],
  "item": [

    {
      "name": "1 — Auth",
      "item": [
        {
          "name": "1.1 Login exitoso (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Tiene access_token', () => pm.expect(json.access_token).to.be.a('string'));",
                  "pm.test('Tiene refresh_token', () => pm.expect(json.refresh_token).to.be.a('string'));",
                  "pm.test('token_type es bearer', () => pm.expect(json.token_type).to.eql('bearer'));",
                  "pm.environment.set('accessToken', json.access_token);",
                  "pm.environment.set('refreshToken', json.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "{{adminUser}}" },
                { "key": "password", "value": "{{adminPass}}" }
              ]
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "1.2 Login — credenciales inválidas (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "const json = pm.response.json();",
                  "pm.test('Contiene detail', () => pm.expect(json).to.have.property('detail'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "username", "value": "admin" },
                { "key": "password", "value": "PasswordIncorrecto999!" }
              ]
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "1.3 Login — cuerpo vacío (422 Validation)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 422', () => pm.response.to.have.status(422));",
                  "const json = pm.response.json();",
                  "pm.test('Tiene error o detail (backend usa error, no detail estándar FastAPI)', () => {",
                  "  const hasError = json.hasOwnProperty('error') || json.hasOwnProperty('detail');",
                  "  pm.expect(hasError).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": { "mode": "urlencoded", "urlencoded": [] },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "1.4 GET /auth/me — token válido",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Tiene username', () => pm.expect(json.username).to.be.a('string'));",
                  "pm.test('Tiene rol', () => pm.expect(json.rol).to.be.a('string'));",
                  "pm.test('Tiene id', () => pm.expect(json.id).to.be.a('number'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "1.5 GET /auth/me — sin token (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/me"
          }
        },
        {
          "name": "1.6 POST /auth/refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Nuevo access_token', () => pm.expect(json.access_token).to.be.a('string'));",
                  "pm.environment.set('accessToken', json.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\"refresh_token\": \"{{refreshToken}}\"}"
            },
            "url": "{{baseUrl}}/auth/refresh"
          }
        }
      ]
    },

